# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# CAD 파일 (대용량 바이너리 — git 추적 제외)
/smartech-cad/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
tunnel.log
*.log

# local dev helpers (not committed)
/tools/
/scripts/counter-*.png

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# python cache
__pycache__/
*.pyc
next-env.d.ts

# database
*.db
*.db-journal

# local-only data files (pricing sheets, etc.)
/data/*
# AI 마케팅 자동화용 제품 마스터 테이블은 추적
!/data/product_master_table.csv
!/data/keyword_map.csv
# AI 챗봇 시뮬레이션 레퍼런스 케이스는 추적
!/data/simulation-cases/
!/data/simulation-cases/**

# large archives / local-only junk
*.zip
app/unnamed.png
진공펌프활용분야/
lib/productData.json

# local-only source files (not needed for web server)
제품아이템번호 및 단가/
제품카다로그/
.env*.local

# sensitive — user data backups (password hashes, contact info)
backup-users-*.json

# sensitive — customer contact import sheets
*.xlsx

# user uploads (stored externally in production)
/public/uploads/

# Claude Code workspace
/.claude/
