generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  partNo      String      @unique
  description String
  costPrice   Float
  isImportant Boolean     @default(false)
  category    String?
  pdfFile     String?
  createdAt   DateTime    @default(now())
  stock          Int         @default(0)
  isDiscontinued Boolean     @default(false)
  imageUrl    String?
  quoteItems  QuoteItem[]
}

model User {
  id               Int             @id @default(autoincrement())
  email            String?         @unique
  name             String
  company          String
  passwordHash     String
  tier             String          @default("PENDING")
  createdAt        DateTime        @default(now())
  phone            String?         @unique
  title            String?
  businessNo       String?
  businessFileUrl  String?
  cardImageUrl     String?
  rejectedAt       DateTime?
  aiEstimatedTier  String?
  aiConfidence     Int?
  aiTypeReason     String?
  lastLoginAt      DateTime?
  loginCount       Int             @default(0)
  quotes           Quote[]
  orders           Order[]
  createdQuotes    Quote[]         @relation("QuoteCreatedBy")
  auditLogs        AuditLog[]
  repairRequests   RepairRequest[]
}

model PriceRule {
  tier       String @id
  multiplier Float
}

model Quote {
  id                  Int         @id @default(autoincrement())
  userId              Int?
  status              String      @default("DRAFT")
  note                String?
  createdAt           DateTime    @default(now())
  expiresAt           DateTime?
  taxInvoiceRequested Boolean     @default(false)
  totalAmount         Float?
  sentAt              DateTime?
  sendCount           Int         @default(0)
  createdByAdminId    Int?
  guestName           String?
  guestCompany        String?
  guestEmail          String?
  guestPhone          String?
  guestTier           String?
  user                User?       @relation(fields: [userId], references: [id])
  createdByAdmin      User?       @relation("QuoteCreatedBy", fields: [createdByAdminId], references: [id])
  items               QuoteItem[]
  order               Order?
}

model QuoteItem {
  id                Int      @id @default(autoincrement())
  quoteId           Int
  productId         Int?
  quantity          Int
  unitPrice         Float
  leadTime          String?
  customPartNo      String?
  customDescription String?
  product           Product? @relation(fields: [productId], references: [id])
  quote             Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Order {
  id                      Int       @id @default(autoincrement())
  quoteId                 Int       @unique
  userId                  Int
  status                  String    @default("PENDING")
  contactName             String?
  contactPhone            String?
  deliveryIssue           Boolean   @default(false)
  confirmedAt             DateTime?
  createdAt               DateTime  @default(now())
  deliveryNoteIssuedAt    DateTime?
  deliveryNoteCount       Int       @default(0)
  paymentConfirmedAt      DateTime?
  shippedAt               DateTime?
  deliveryEmailSentAt     DateTime?
  deliveryEmailCount      Int       @default(0)
  quote                   Quote     @relation(fields: [quoteId], references: [id])
  user                    User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  target    String
  targetId  Int?
  payload   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([target, targetId])
  @@index([userId, createdAt])
}

// 이메일·SMS 매직 링크 토큰 (15분 만료)
model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String?
  phone     String?
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
  @@index([phone])
}

// ─────────────────────────────────────────────────
// 수리 플랫폼
// ─────────────────────────────────────────────────

// 펌프 모델별 기본 수리 키트 (엑셀 임포트 or 수동 등록)
model RepairKit {
  id           Int              @id @default(autoincrement())
  pumpFamily   String           // scroll | rotary_vane | booster | dry | other
  pumpMaker    String           @default("EDWARDS")
  pumpModel    String           // "nXDS10i", "RV8", "EH500" 등
  modelGroup   String?          // "nXDS10i/15i" — 화면 표시용 묶음명
  basePrice    Int              @default(0)   // 기본수리 (Tier 1), 0이면 상담 필요
  tier2Price   Int              @default(0)   // 기본수리+파트교체 (Tier 2)
  tier3Price   Int              @default(0)   // 전체수리 (Tier 3)
  description  String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  parts        RepairKitPart[]
  extraParts   RepairKitExtra[]
  requests     RepairRequest[]

  @@index([pumpFamily])
  @@index([pumpModel])
}

// 기본 키트에 포함된 교체 파트 목록
model RepairKitPart {
  id        Int       @id @default(autoincrement())
  kitId     Int
  name      String    // "Tip seal", "Bearing" 등
  quantity  String?   // "x5", "x1" 등
  sortOrder Int       @default(0)
  kit       RepairKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
}

// 추가 교체 시 발생 가능한 파트 및 단가
model RepairKitExtra {
  id        Int       @id @default(autoincrement())
  kitId     Int
  category  String    @default("")  // "전장수리", "팬교체", "블레이드교체" 등
  name      String    // "controller", "Fan", "Blade" 등
  price     Int       // 원가 (고객가 = 원가 × 1.2)
  kit       RepairKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
}

// 수리 접수
model RepairRequest {
  id            Int               @id @default(autoincrement())
  repairNo      String            @unique  // SM-YYMMDD-NN
  userId        Int?              // 로그인 회원 (null 이면 비회원 문의)

  // 장비 정보
  pumpFamily    String            // scroll | rotary_vane | booster | dry | other
  pumpMaker     String            @default("EDWARDS")
  pumpModel     String
  pumpSerial    String?
  kitId         Int?              // 매핑된 수리 키트

  // 증상 (복수 선택 가능)
  symptoms      String[]
  symptomNote   String?           // 기타 증상 메모

  // 금액 (단위: 원)
  baseAmount    Int               @default(0)
  extraAmount   Int               @default(0)  // 관리자가 추가한 파트비
  totalAmount   Int               @default(0)

  // 연락처 (비회원도 입력)
  contactName   String
  contactPhone  String
  contactEmail  String?
  company       String?

  // 진행 상태
  // RECEIVED(접수완료) | IN_PROGRESS(수리진행) | INSPECTION(검사중) | COMPLETED(수리완료) | DELIVERED(납품완료) | CANCELLED(취소)
  status        String            @default("RECEIVED")

  // AI 인식 결과
  aiConfidence  String?           // high | medium | low | null
  aiModelRaw    String?           // AI가 인식한 원본 모델명

  // 선택 수리 단계 (레거시 — B안 전환 후 미사용)
  repairTier    Int?
  // 선택한 추가 항목 (B안: 체크박스 선택)
  selectedExtrasJson String?     // JSON: [{category, name, costPrice}]

  // 관리자 메모 / 외주 배정
  adminNote     String?
  assignedAt    DateTime?         // 외주업체 배정 시각

  // 발송 이력
  docsSentAt    DateTime?         // 최종 서류 발송 시각
  docsSentCount Int               @default(0)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User?             @relation(fields: [userId], references: [id])
  kit           RepairKit?        @relation(fields: [kitId], references: [id])
  files         RepairFile[]
  statusLogs    RepairStatusLog[]
  uploadTokens  UploadToken[]

  @@index([status])
  @@index([repairNo])
  @@index([userId])
  @@index([createdAt])
}

// 수리 관련 파일 (분해 사진, 검사 성적서, 견적서 PDF 등) — 영구 보관
model RepairFile {
  id          Int           @id @default(autoincrement())
  repairId    Int
  // disassembly_photo | inspection_cert | quote_pdf | delivery_note | bank_copy | other
  fileType    String
  fileName    String
  fileUrl     String        // Vercel Blob URL
  fileSize    Int?          // bytes
  uploadedBy  String        // customer | admin | outsource
  createdAt   DateTime      @default(now())

  repair      RepairRequest @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([repairId, fileType])
}

// 수리 상태 변경 이력
model RepairStatusLog {
  id        Int           @id @default(autoincrement())
  repairId  Int
  fromStatus String?
  toStatus  String
  note      String?
  changedBy String        // admin | system | customer
  createdAt DateTime      @default(now())

  repair    RepairRequest @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([repairId])
}

// 외주업체 일회용 업로드 토큰 (로그인 없이 파일 업로드)
model UploadToken {
  id        String        @id @default(cuid())
  repairId  Int
  token     String        @unique @default(cuid())
  expiresAt DateTime      // 생성 후 30일
  usedAt    DateTime?     // 최초 업로드 시각 (만료 X, 추적용)
  createdAt DateTime      @default(now())

  repair    RepairRequest @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ─────────────────────────────────────────────────
// 기존 거래처 화이트리스트 — 엑셀 임포트 or 수동 등록
model KnownCompany {
  id          Int            @id @default(autoincrement())
  companyName String
  phone       String?
  email       String?
  tier        String         // DEALER | OEM | ENDUSER | KEY_DEALER | VIP_DEALER
  source      String         @default("excel") // excel | manual | html_backup
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  contacts    KnownContact[]

  @@index([phone])
  @@index([email])
  @@index([companyName])
}

// 거래처별 담당자 목록
model KnownContact {
  id        Int          @id @default(autoincrement())
  companyId Int
  name      String
  title     String?
  tel       String?
  mobile    String?
  email     String?
  createdAt DateTime     @default(now())
  company   KnownCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// 블로그 게시글 (AI 파이프라인 생성 + 직접 작성)
model BlogPost {
  id           Int       @id @default(autoincrement())
  title        String
  content      String
  naverContent String    @default("")  // 네이버 블로그 전용 버전 (naver.md)
  metaDesc     String    @default("")
  tags         String    @default("")
  category     String    @default("일반")
  status       String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  sourceFile   String?
  photos       String?   // JSON: ["04_수리정비/xxx.jpg", ...] — 사용된 현장사진 경로
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([category])
}

// 사이트 설정 키-값 저장소
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
