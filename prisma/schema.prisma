generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  partNo      String      @unique
  description String
  costPrice   Float
  isImportant Boolean     @default(false)
  category    String?
  pdfFile     String?
  createdAt   DateTime    @default(now())
  stock       Int         @default(0)
  imageUrl    String?
  quoteItems  QuoteItem[]
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  name             String
  company          String
  passwordHash     String
  tier             String   @default("PENDING")
  createdAt        DateTime @default(now())
  phone            String?
  businessNo       String?
  businessFileUrl  String?
  cardImageUrl     String?
  quotes           Quote[]
  orders           Order[]
}

model PriceRule {
  tier       String @id
  multiplier Float
}

model Quote {
  id                  Int         @id @default(autoincrement())
  userId              Int
  status              String      @default("DRAFT")
  note                String?
  createdAt           DateTime    @default(now())
  expiresAt           DateTime?
  taxInvoiceRequested Boolean     @default(false)
  totalAmount         Float?
  user                User        @relation(fields: [userId], references: [id])
  items               QuoteItem[]
  order               Order?
}

model QuoteItem {
  id        Int     @id @default(autoincrement())
  quoteId   Int
  productId Int
  quantity  Int
  unitPrice Float
  product   Product @relation(fields: [productId], references: [id])
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Order {
  id             Int       @id @default(autoincrement())
  quoteId        Int       @unique
  userId         Int
  status         String    @default("PENDING")
  contactName    String?
  contactPhone   String?
  deliveryIssue  Boolean   @default(false)
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())
  quote          Quote     @relation(fields: [quoteId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
}
