generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             Int         @id @default(autoincrement())
  partNo         String      @unique
  description    String
  costPrice      Float
  isImportant    Boolean     @default(false)
  category       String?
  pdfFile        String?
  createdAt      DateTime    @default(now())
  stock          Int         @default(0)
  isDiscontinued Boolean     @default(false)
  imageUrl       String?
  department     String?     // IV | SV | AK
  minStock       Int         @default(0)
  orderQty       Int         @default(0)
  supplierName   String?
  quoteItems     QuoteItem[]
}

model User {
  id               Int             @id @default(autoincrement())
  email            String?         @unique
  name             String
  company          String
  passwordHash     String
  tier             String          @default("PENDING")
  createdAt        DateTime        @default(now())
  phone            String?         @unique
  title            String?
  businessNo       String?
  businessFileUrl  String?
  cardImageUrl     String?
  rejectedAt       DateTime?
  aiEstimatedTier  String?
  aiConfidence     Int?
  aiTypeReason     String?
  lastLoginAt      DateTime?
  loginCount       Int             @default(0)
  quotes           Quote[]
  chatLogs         ChatLog[]
  orders           Order[]
  createdQuotes    Quote[]         @relation("QuoteCreatedBy")
  auditLogs        AuditLog[]
  repairRequests   RepairRequest[]
}

model PriceRule {
  tier       String @id
  multiplier Float
}

model Quote {
  id                  Int         @id @default(autoincrement())
  userId              Int?
  status              String      @default("DRAFT")
  note                String?
  createdAt           DateTime    @default(now())
  expiresAt           DateTime?
  taxInvoiceRequested Boolean     @default(false)
  totalAmount         Float?
  sentAt              DateTime?
  sendCount           Int         @default(0)
  sentChannel         String?     // SYSTEM(자동발송) | MANUAL(PDF저장 후 수동발송) — sentAt이 채워질 때만 의미 있음
  createdByAdminId    Int?
  guestName           String?
  guestCompany        String?
  guestEmail          String?
  guestPhone          String?
  guestTitle          String?
  guestTier           String?
  paymentTerm         String?
  user                User?       @relation(fields: [userId], references: [id])
  createdByAdmin      User?       @relation("QuoteCreatedBy", fields: [createdByAdminId], references: [id])
  items               QuoteItem[]
  order               Order?
}

model QuoteItem {
  id                Int      @id @default(autoincrement())
  quoteId           Int
  productId         Int?
  quantity          Int
  unitPrice         Float
  leadTime          String?
  customPartNo      String?
  customDescription String?
  product           Product? @relation(fields: [productId], references: [id])
  quote             Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Order {
  id                      Int       @id @default(autoincrement())
  quoteId                 Int       @unique
  userId                  Int
  status                  String    @default("PENDING")
  contactName             String?
  contactPhone            String?
  deliveryIssue           Boolean   @default(false)
  confirmedAt             DateTime?
  createdAt               DateTime  @default(now())
  deliveryNoteIssuedAt    DateTime?
  deliveryNoteCount       Int       @default(0)
  paymentConfirmedAt      DateTime?
  shippedAt               DateTime?
  deliveryEmailSentAt     DateTime?
  deliveryEmailCount      Int       @default(0)
  quote                   Quote     @relation(fields: [quoteId], references: [id])
  user                    User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  target    String
  targetId  Int?
  payload   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([target, targetId])
  @@index([userId, createdAt])
}

// 이메일·SMS 매직 링크 토큰 (15분 만료)
model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String?
  phone     String?
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
  @@index([phone])
}

// ─────────────────────────────────────────────────
// 수리 플랫폼
// ─────────────────────────────────────────────────

// 펌프 모델별 기본 수리 키트 (엑셀 임포트 or 수동 등록)
model RepairKit {
  id           Int              @id @default(autoincrement())
  pumpFamily   String           // scroll | rotary_vane | booster | dry | other
  pumpMaker    String           @default("EDWARDS")
  pumpModel    String           // "nXDS10i", "RV8", "EH500" 등
  modelGroup   String?          // "nXDS10i/15i" — 화면 표시용 묶음명
  basePrice    Int              @default(0)   // 기본수리 (Tier 1), 0이면 상담 필요
  tier2Price   Int              @default(0)   // 기본수리+파트교체 (Tier 2)
  tier3Price   Int              @default(0)   // 전체수리 (Tier 3)
  description  String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  parts        RepairKitPart[]
  extraParts   RepairKitExtra[]
  requests     RepairRequest[]

  @@index([pumpFamily])
  @@index([pumpModel])
}

// 기본 키트에 포함된 교체 파트 목록
model RepairKitPart {
  id        Int       @id @default(autoincrement())
  kitId     Int
  name      String    // "Tip seal", "Bearing" 등
  quantity  String?   // "x5", "x1" 등
  sortOrder Int       @default(0)
  kit       RepairKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
}

// 추가 교체 시 발생 가능한 파트 및 단가
model RepairKitExtra {
  id        Int       @id @default(autoincrement())
  kitId     Int
  category  String    @default("")  // "전장수리", "팬교체", "블레이드교체" 등
  name      String    // "controller", "Fan", "Blade" 등
  price     Int       // 원가 (고객가 = 원가 × 1.2)
  kit       RepairKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
}

// 수리 접수
model RepairRequest {
  id            Int               @id @default(autoincrement())
  repairNo      String            @unique  // SM-YYMMDD-NN
  userId        Int?              // 로그인 회원 (null 이면 비회원 문의)

  // 장비 정보
  pumpFamily    String            // scroll | rotary_vane | booster | dry | other
  pumpMaker     String            @default("EDWARDS")
  pumpModel     String
  pumpSerial    String?
  kitId         Int?              // 매핑된 수리 키트

  // 증상 (복수 선택 가능)
  symptoms      String[]
  symptomNote   String?           // 기타 증상 메모

  // 금액 (단위: 원)
  baseAmount    Int               @default(0)
  extraAmount   Int               @default(0)  // 관리자가 추가한 파트비
  totalAmount   Int               @default(0)

  // 연락처 (비회원도 입력)
  contactName   String
  contactPhone  String
  contactEmail  String?
  company       String?

  // 진행 상태
  // RECEIVED(접수완료) | IN_PROGRESS(수리진행) | INSPECTION(검사중) | COMPLETED(수리완료) | DELIVERED(납품완료) | CANCELLED(취소)
  status        String            @default("RECEIVED")

  // AI 인식 결과
  aiConfidence  String?           // high | medium | low | null
  aiModelRaw    String?           // AI가 인식한 원본 모델명

  // 선택 수리 단계 (레거시 — B안 전환 후 미사용)
  repairTier    Int?
  // 선택한 추가 항목 (B안: 체크박스 선택)
  selectedExtrasJson String?     // JSON: [{category, name, costPrice}]

  // 관리자 메모 / 외주 배정
  adminNote       String?
  quoteRemarks    String?           // 견적서 PDF REMARKS 란 출력
  extraPartsName  String?           // 추가 파트 품목명 (견적서 PDF 출력)
  assignedAt      DateTime?         // 외주업체 배정 시각

  // 발송 이력
  docsSentAt    DateTime?         // 최종 서류 발송 시각
  docsSentCount Int               @default(0)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User?             @relation(fields: [userId], references: [id])
  kit           RepairKit?        @relation(fields: [kitId], references: [id])
  files         RepairFile[]
  statusLogs    RepairStatusLog[]
  uploadTokens  UploadToken[]

  @@index([status])
  @@index([repairNo])
  @@index([userId])
  @@index([createdAt])
}

// 수리 관련 파일 (분해 사진, 검사 성적서, 견적서 PDF 등) — 영구 보관
model RepairFile {
  id          Int           @id @default(autoincrement())
  repairId    Int
  // disassembly_photo | inspection_cert | quote_pdf | delivery_note | bank_copy | other
  fileType    String
  fileName    String
  fileUrl     String        // Vercel Blob URL
  fileSize    Int?          // bytes
  uploadedBy  String        // customer | admin | outsource
  createdAt   DateTime      @default(now())

  repair      RepairRequest @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([repairId, fileType])
}

// 수리 상태 변경 이력
model RepairStatusLog {
  id        Int           @id @default(autoincrement())
  repairId  Int
  fromStatus String?
  toStatus  String
  note      String?
  changedBy String        // admin | system | customer
  createdAt DateTime      @default(now())

  repair    RepairRequest @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([repairId])
}

// 외주업체 일회용 업로드 토큰 (로그인 없이 파일 업로드)
model UploadToken {
  id        String        @id @default(cuid())
  repairId  Int
  token     String        @unique @default(cuid())
  expiresAt DateTime      // 생성 후 30일
  usedAt    DateTime?     // 최초 업로드 시각 (만료 X, 추적용)
  createdAt DateTime      @default(now())

  repair    RepairRequest @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ─────────────────────────────────────────────────
// 기존 거래처 화이트리스트 — 엑셀 임포트 or 수동 등록
model KnownCompany {
  id            Int                @id @default(autoincrement())
  companyName   String
  phone         String?
  email         String?
  tier          String             // DEALER | OEM | ENDUSER | KEY_DEALER | VIP_DEALER
  paymentTerm   String?            // a=납품전현금 b=계약30%납품전70% d=계약30%익월말일70% e=정기결제 c=직접입력
  source        String             @default("excel") // excel | manual | html_backup
  businessNo    String?            // 사업자등록번호 (하이픈 없이 10자리)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  contacts      KnownContact[]
  offlineRepairs OfflineRepairJob[]
  repairReports RepairReport[]

  @@index([phone])
  @@index([email])
  @@index([companyName])
  @@index([businessNo])
}

// 거래처별 담당자 목록
model KnownContact {
  id        Int          @id @default(autoincrement())
  companyId Int
  name      String
  title     String?
  tel       String?
  mobile    String?
  email     String?
  createdAt DateTime     @default(now())
  company   KnownCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// 블로그 게시글 (AI 파이프라인 생성 + 직접 작성)
model BlogPost {
  id           Int       @id @default(autoincrement())
  slug         String?   @unique // SEO용 의미형 URL (/blog/edwards-rv-oil-pump 등). 없으면 /blog/{id}로 접근
  title        String
  content      String
  naverContent String    @default("")  // 네이버 블로그 전용 버전 (naver.md)
  metaDesc     String    @default("")
  tags         String    @default("")
  category     String    @default("일반")
  status       String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  sourceFile   String?
  photos       String?   // JSON: ["04_수리정비/xxx.jpg", ...] — 사용된 현장사진 경로
  faqSchema    String    @default("")  // JSON-LD FAQPage 구조화 데이터 (faq.json)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([category])
}

// 사이트 설정 키-값 저장소
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────
// 이메일 자동화 — 수신 이메일 처리 대기열
// ─────────────────────────────────────────────────
model EmailTask {
  id             Int       @id @default(autoincrement())
  gmailMessageId String    @unique  // 중복 수신 방지

  // 발신자
  fromEmail      String
  fromName       String?
  subject        String
  bodyText       String    @db.Text
  receivedAt     DateTime

  // AI 분류
  // QUOTE_INQUIRY | ECOUNT_ORDER | ECOUNT_PRICE_REQUEST | OTHER
  emailType      String    @default("OTHER")
  aiConfidence   Int?                        // 0~100
  parsedData     Json?                       // 품목·수량 등 구조화 데이터
  aiDraft        String?   @db.Text          // AI 초안 답변

  // 관리자 처리
  // PENDING | APPROVED | REJECTED | IGNORED
  status         String    @default("PENDING")
  adminNote      String?
  approvedAt     DateTime?

  // 연결 레코드
  quoteId        Int?      // 이 이메일로 생성된 견적 ID

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([emailType])
  @@index([receivedAt])
}

// ─────────────────────────────────────────────────
// X(트위터) 콘텐츠 — AI 초안 생성 + 관리자 승인 대기열
// ─────────────────────────────────────────────────
model XPost {
  id         Int       @id @default(autoincrement())
  topic      String    // 예: "겨울철 펌프 오일 관리"
  content    String    @db.Text // AI 생성 초안 (280자 이내)

  // 관리자 처리
  // PENDING | APPROVED | REJECTED | PUBLISHING(게시 시도 중 — 중복게시 방지용 임시 상태) | POSTED
  status     String    @default("PENDING")
  adminNote  String?
  approvedAt DateTime?

  // 게시 (X API 키 발급 후 연결 — 현재 미사용)
  postedAt   DateTime?
  tweetId    String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────
// 부서별 담당자 설정 (IV / SV / AK)
// ─────────────────────────────────────────────────
model DepartmentContact {
  id             Int      @id @default(autoincrement())
  code           String   @unique  // IV | SV | AK
  contactName    String
  contactEmail   String
  ccEmails       String?           // 쉼표 구분 참조 이메일
  defaultMessage String?  @db.Text // 기본 발주 문구 (수정 가능)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────
// 수동 거래명세표
// ─────────────────────────────────────────────────
model ManualDeliveryNote {
  id              Int      @id @default(autoincrement())
  noteNo          String   @unique  // SMT-YYYY-D-NNNNNN
  status          String   @default("DRAFT")  // DRAFT | SENT

  // PDF에 표시되는 발행일 (관리자가 직접 지정 가능, 기본값=저장 시점)
  issuedDate      DateTime @default(now())

  // 수신자 정보 (발행 시점 스냅샷)
  toCompany       String
  toName          String?
  toTitle         String?
  toEmail         String?
  toPhone         String?
  toBizNo         String?

  // 내부 메모 (PDF 미출력 — 납품처·참고사항 등 내부 기록용)
  memo            String?

  // PDF 비고란 (PDF 출력)
  remarks         String?  @db.Text

  // 통장사본 포함 여부
  includeBankInfo Boolean  @default(true)

  // 금액 스냅샷
  totalSupply     Float    @default(0)
  totalVat        Float    @default(0)
  totalAmount     Float    @default(0)

  // 발송 이력
  sentAt          DateTime?
  sentTo          String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           ManualDeliveryNoteItem[]

  @@index([status])
  @@index([createdAt])
}

model ManualDeliveryNoteItem {
  id          Int                @id @default(autoincrement())
  noteId      Int
  note        ManualDeliveryNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  // 발행 시점 스냅샷 (제품 변경돼도 이력 불변)
  partNo      String
  description String
  quantity    Int
  unitPrice   Float

  // 원본 제품 참조 (선택 — 스냅샷이 실제 값)
  productId   Int?
  sortOrder   Int    @default(0)

  @@index([noteId])
}

// ─────────────────────────────────────────────────
// 수동 발주서 (스마텍 → 공급업체)
// ─────────────────────────────────────────────────
model ManualPurchaseOrder {
  id              Int      @id @default(autoincrement())
  orderNo         String   @unique  // SMT-YYYY-P-NNNNNN
  status          String   @default("DRAFT")  // DRAFT | SENT

  // 담당 부서
  department      String   // IV | SV | AK

  // 공급업체 정보 (발행 시점 스냅샷)
  toCompany       String
  toName          String?
  toEmail         String?  // 발주 초기엔 이메일 미확정일 수 있음
  ccEmails        String?  // 쉼표 구분 참조 이메일

  // 발주 정보
  orderDate       DateTime @default(now())   // 발주일
  requestedDate   DateTime?                  // 납기 요청일
  message         String?  @db.Text          // 발주 문구 (기본값 from DepartmentContact)
  memo            String?                    // 내부 메모

  // 발송 이력
  sentAt          DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           ManualPurchaseOrderItem[]

  @@index([status])
  @@index([department])
  @@index([createdAt])
}

model ManualPurchaseOrderItem {
  id          Int                 @id @default(autoincrement())
  orderId     Int
  order       ManualPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // 발행 시점 스냅샷
  partNo      String
  description String
  quantity    Int
  unitPrice   Float               // 발주서는 단가 필수

  // 원본 제품 참조 (선택)
  productId   Int?
  sortOrder   Int    @default(0)

  @@index([orderId])
}

// 재고 관리
// ─────────────────────────────────────────────────
model InventoryItem {
  id           Int      @id @default(autoincrement())
  category     String                      // Pump, Filter, Gauge, Oil, etc.
  department   String                      // SV | AK
  partNo       String   @unique
  name         String
  currentStock Int      @default(0)
  minStock     Int      @default(0)
  orderQty     Int      @default(1)
  unitPrice    Float    @default(0)
  leadTime     String?                     // "4주"
  supplier     String?                     // "에드워드코리아"
  memo         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([department])
  @@index([isActive])
}

// AI 챗봇 대화 기록
// ─────────────────────────────────────────────────
// 오프라인 수리 접수 시스템
// ─────────────────────────────────────────────────

model OfflineRepairJob {
  id              Int       @id @default(autoincrement())
  jobNo           String    @unique // SMT-YYYY-R-NNNNNN
  status          String    @default("RECEIVED")
  // RECEIVED → SENT_TO_SUB → WORKING → UPLOADED → QUOTE_SENT → CONFIRMED → DELIVERED

  // 거래처 연결
  companyId       Int?
  company         KnownCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactName     String?
  contactEmail    String?
  contactPhone    String?

  // 장비 정보
  pumpMaker       String    @default("EDWARDS")
  pumpModel       String
  serialNo        String?
  voltage         String?
  repairReason    String?   // 정기 | 고장 | 기타

  // 외주 협력사
  subName         String?
  subEmail        String?

  // 업로드 토큰 (협력사 전용 링크)
  uploadToken     String?   @unique
  tokenExpiresAt  DateTime?
  uploadedAt      DateTime?

  // 날짜
  receivedDate    DateTime  @default(now())
  requestedDate   DateTime?

  memo            String?

  // 수리 견적 (Phase 2)
  repairCost      Int?      // 총 견적금액 (quoteItems 합계, 필요 시 직접 수정 가능)
  repairPartsText String?   // 기본수리 교체부품 메모 (자유 입력, PDF 기본수리 항목 하단에 표시)
  inspectorName   String?
  quoteRemarks    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  inspectionItems OfflineRepairInspectionItem[]
  files           OfflineRepairFile[]
  quoteItems      OfflineRepairQuoteItem[]

  @@index([companyId])
  @@index([status])
  @@index([uploadToken])
}

// 수리견적서 품목 (기본수리 1줄 + 추가파트 N줄) — 온라인 수리접수·거래명세표와 동일한 구조
model OfflineRepairQuoteItem {
  id          Int              @id @default(autoincrement())
  jobId       Int
  job         OfflineRepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String           // "기본수리 — DUO3", "Blade 교체" 등
  quantity    Int              @default(1)
  unitPrice   Int              // 공급가 (고객가, 마진 반영된 값)
  sortOrder   Int              @default(0)

  @@index([jobId])
}

model OfflineRepairInspectionItem {
  id          Int              @id @default(autoincrement())
  jobId       Int
  job         OfflineRepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sortOrder   Int              @default(0)
  itemLabel   String           // "Vacuum (Scroll)"
  unit        String?          // "Torr"
  spec        String?          // "≤9.0×10⁻²"
  value       String?          // 협력사 입력값
  isNA        Boolean          @default(false)
  pass        Boolean?
  remark      String?

  @@index([jobId])
}

model OfflineRepairFile {
  id          Int              @id @default(autoincrement())
  jobId       Int
  job         OfflineRepairJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fileType    String           // PHOTO | PHOTO_ZIP
  fileName    String
  fileUrl     String
  fileSize    Int?
  isSelected  Boolean          @default(false) // PDF 삽입 사진 선택 여부
  uploadedAt  DateTime         @default(now())

  @@index([jobId])
}

// ─────────────────────────────────────────────────
// TEMC 외주 수선보고서 — 외주업체 작성 → 관리자 검토 → 고객 열람
// ─────────────────────────────────────────────────

model RepairReport {
  id              Int       @id @default(autoincrement())
  reportNo        String    @unique // TEMC-YYMMDD-NN

  companyId       Int?
  company         KnownCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // 펌프 정보 (Phase 1: 자유 입력 필드 — 별도 Pump 마스터는 다음 단계에서 추가)
  pumpModel       String
  pumpSerial      String?
  pumpLocation    String?
  pumpAssetNo     String?   // 향후 이력 대시보드 그룹핑 키로 재사용 가능하도록 미리 확보

  symptomText     String?   @db.Text // 이상현상
  reasonText      String?   @db.Text // 수리사유

  // DRAFT → SENT_TO_SUB → SUBMITTED → REVIEWED → SENT_TO_CUSTOMER → VIEWED
  status          String    @default("DRAFT")

  subName         String?
  subEmail        String?
  adminNote       String?

  receivedDate    DateTime  @default(now())
  repairedDate    DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           RepairReportItem[]
  photos          RepairReportPhoto[]
  submitTokens    RepairReportSubmitToken[]
  viewTokens      RepairReportViewToken[]

  @@index([companyId])
  @@index([status])
}

// CHECKLIST(예상수리내용) / MEASUREMENT(측정치표) / PART(부품교환내역) 3섹션을
// 관리자가 자유롭게 행 추가·수정할 수 있도록 하나의 제네릭 테이블로 표현
model RepairReportItem {
  id          Int          @id @default(autoincrement())
  reportId    Int
  report      RepairReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  section     String       // CHECKLIST | MEASUREMENT | PART
  sortOrder   Int          @default(0)
  label       String

  isChecked   Boolean      @default(false) // CHECKLIST 전용

  specValue   String?                      // MEASUREMENT 전용 (정상치)
  measured    String?                      // MEASUREMENT 전용 (측정치)
  judgment    String?                      // MEASUREMENT 전용 (판정)

  quantity    String?                      // PART 전용
  partNo      String?                      // PART 전용

  remark      String?

  @@index([reportId, section])
}

// 분해사진 / 정비사진
model RepairReportPhoto {
  id          Int          @id @default(autoincrement())
  reportId    Int
  report      RepairReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  section     String       // DISASSEMBLY | MAINTENANCE
  fileName    String
  fileUrl     String
  fileSize    Int?
  sortOrder   Int          @default(0)
  isSelected  Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@index([reportId, section])
}

// 외주업체 제출용 토큰 (로그인 없음)
model RepairReportSubmitToken {
  id         String       @id @default(cuid())
  reportId   Int
  report     RepairReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  token      String       @unique @default(cuid())
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime     @default(now())

  @@index([token])
}

// 고객(TEMC) 열람용 토큰 (로그인 없음, 제출 토큰과 별도)
model RepairReportViewToken {
  id         String       @id @default(cuid())
  reportId   Int
  report     RepairReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  token      String       @unique @default(cuid())
  expiresAt  DateTime
  viewedAt   DateTime?
  viewCount  Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([token])
}

model ChatLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company     String?
  userName    String?
  userTier    String?
  userEmail   String?
  userMessage String   @db.Text
  aiResponse  String   @db.Text
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
